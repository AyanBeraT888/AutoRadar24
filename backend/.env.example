PORT=3000
NODE_ENV=production

# Database (mysql for Cloud Docker/TiDB, or sqlite for local dev)
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=auto24
MYSQL_USER=auto24_user
MYSQL_PASSWORD=change_this_to_strong_password

# JWT Authentication Secret (run `npm run generate-secrets` to generate)
JWT_SECRET=change_this_to_a_random_64_character_hex_secret

# Idle & Speed Thresholds
IDLE_TIMEOUT_SECONDS=15
MOVEMENT_THRESHOLD_METERS=7
SPEED_THRESHOLD_KMH=5
