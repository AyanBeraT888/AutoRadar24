# ==============================================================================
# Auto 24 — Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file as `.env` in the root folder (or run: npm run generate-secrets -- --write-env)
# 2. Populate your strong passwords and domain before launching Docker Compose.
# ==============================================================================

# Server Core Settings
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Options
# ------------------------------------------------------------------------------
# Option A: Built-in 24/7 Docker MySQL 8.0 (Recommended for Oracle Cloud / VPS)
DB_TYPE=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=auto24
MYSQL_USER=auto24_user
MYSQL_PASSWORD=change_this_to_a_strong_password
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password

# Option B: External TiDB Cloud Serverless MySQL (Alternative 100% Free Cloud DB)
# DATABASE_URL=mysql://<USER>:<PASSWORD>@<HOST>:4000/<DB>?ssl={"rejectUnauthorized":true}
# MYSQL_SSL=true

# Option C: Zero-Config Local SQLite (Fallback for offline dev/tests)
# DB_TYPE=sqlite
# DB_PATH=./data/auto24.db

# ------------------------------------------------------------------------------
# Security & Cryptographic Signing
# ------------------------------------------------------------------------------
# Cryptographically random HMAC-SHA256 secret (minimum 32 characters, 64-hex recommended)
# Run `npm run generate-secrets` to produce a fresh 256-bit key.
JWT_SECRET=change_this_to_a_random_64_character_hex_secret

# ------------------------------------------------------------------------------
# Automated Reverse Proxy & SSL (Caddy / Let's Encrypt)
# ------------------------------------------------------------------------------
# Set to your domain (e.g. auto24.example.com or a free DuckDNS subdomain: auto24.duckdns.org)
# Leave as :80 for direct HTTP IP testing.
DOMAIN=:80
ACME_EMAIL=admin@auto24.local

# ------------------------------------------------------------------------------
# Telemetry & Staleness Heuristics
# ------------------------------------------------------------------------------
IDLE_TIMEOUT_SECONDS=15
MOVEMENT_THRESHOLD_METERS=7
SPEED_THRESHOLD_KMH=5
