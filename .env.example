# Auto 24 Environment Variables Configuration Template
# Duplicate this file as .env and fill in your actual credentials.

# Server Port
PORT=3000
NODE_ENV=production

# Database Configuration (mysql for TiDB Cloud / SQLite for offline dev)
DB_TYPE=mysql

# TiDB Cloud MySQL Connection String
# Format: mysql://<user>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://<YOUR_USER>:<YOUR_PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?ssl={"rejectUnauthorized":true}
MYSQL_SSL=true

# Driver Idle & Movement Thresholds
IDLE_TIMEOUT_SECONDS=15
MOVEMENT_THRESHOLD_METERS=7
SPEED_THRESHOLD_KMH=5
