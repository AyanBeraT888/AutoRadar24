    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.19",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "^13.13.5"
  },
  "devDependencies": {
