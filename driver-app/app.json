{
  "expo": {
    "name": "AutoRadar18",
    "slug": "autoradar18",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.autoradar18.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "HIGH_SAMPLING_RATE_SENSORS",
        "ACTIVITY_RECOGNITION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AutoRadar18 requires location access to broadcast your vehicle position while on duty.",
          "locationAlwaysPermission": "AutoRadar18 broadcasts your live position in the background even when your screen is locked.",
          "locationWhenInUsePermission": "AutoRadar18 requires location access to transmit live coordinates.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "81864fb5-8498-4fb5-bd27-edfc0587e570"
      }
    },
    "owner": "ayanberat888s-team"
  }
}
